{
  "manifest_version": 3,
  "name": "KON Ad-Shield for YouTube",
  "version": "1.0.0",
  "description": "Zero-ad playback for YouTube embed player in KON Media and across the web.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*",
    "*://*.doubleclick.net/*",
    "*://*.googlesyndication.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/embed/*",
        "*://*.youtube-nocookie.com/embed/*",
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["content.js"]
    }
  ]
}
